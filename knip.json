{
  "$schema": "https://knip.dev/reference/schema",
  "entry": [
    "frontend/src/**/*.{js,jsx}",
    "backend/nest-api/src/**/*.ts"
  ],
  "project": [
    "frontend/src/**/*.{js,jsx}",
    "backend/nest-api/src/**/*.ts"
